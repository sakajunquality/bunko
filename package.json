{
  "name": "bunko",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Build OCI images from Bun applications without Dockerfiles",
  "bin": {
    "bunko": "./packages/bunko/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.11 <1.4"
  },
  "scripts": {
    "dev": "bun packages/bunko/cli.ts",
    "build": "bun build packages/bunko/cli.ts --target=bun --minify --outfile=dist/bunko.js",
    "test": "bun test --timeout 15000",
    "bench:syntax": "bun test/syntax-benchmark.ts",
    "release:prepare": "bun scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun test/smoke.ts",
    "test:registry": "bun test/registry-conformance.ts",
    "test:registry-local": "bun test/registry-local.ts",
    "test:m1-smoke": "bun test/m1-smoke.ts",
    "test:m2c-smoke": "bun test/m2c-smoke.ts",
    "test:bundled-smoke": "bun test/bundled-smoke.ts",
    "test:m2b-smoke": "bun test/m2b-smoke.ts",
    "test:m2a-smoke": "bun test/m2a-smoke.ts",
    "check": "bun run typecheck && bun run test",
    "test:m3-smoke": "bun test/m3-smoke.ts",
    "test:m4-smoke": "bun test/m4-smoke.ts",
    "test:apply-smoke": "bun test/apply-smoke.ts",
    "bench:performance": "bun test/performance-benchmark.ts",
    "test:m6-smoke": "bun test/m6-smoke.ts",
    "test:ko-smoke": "bun test/ko-smoke.ts",
    "bench:builders": "bun test/buildkit-benchmark.ts",
    "test:local-resolve": "bun test/local-resolve-smoke.ts",
    "test:prepared-deps": "bun test/buildkit-deps-smoke.ts",
    "test:zstd-smoke": "bun test/zstd-smoke.ts",
    "test:metadata": "bun test/metadata-smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
