{
  "name": "font-validation",
  "private": true,
  "type": "module",
  "module": "index.mjs",
  "dependencies": {
    "@napi-rs/canvas": "1.0.5",
    "@resvg/resvg-js": "2.6.2"
  },
  "bunko": {
    "base": "oven/bun@sha256:7e8ed3961db1cdedf17d516dda87948cfedbd294f53bf16462e5b57ed3fff0f1",
    "external": [
      "@napi-rs/canvas",
      "@resvg/resvg-js"
    ],
    "assetMappings": [
      {
        "context": "fonts",
        "from": "noto",
        "to": "/usr/share/fonts/bunko",
        "mode": "0444"
      }
    ],
    "assets": [
      "fonts.conf"
    ],
    "env": {
      "FONTCONFIG_FILE": "/app/fonts.conf"
    }
  }
}
